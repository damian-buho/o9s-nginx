# CSP and COEP ride $o9s_nginx_document: a type outside O9S_NGINX_DOCUMENT_TYPES maps to empty and nginx omits the header
map $sent_http_content_type $o9s_nginx_document {
    default "";
    "~^({{ ENV.O9S_NGINX_DOCUMENT_TYPES }})" 1;
}

# A PDF renders in a browser viewer, so it carries the document CSP as well — COEP stays document-only
map $sent_http_content_type $o9s_nginx_pdf {
    default "";
    "~^application/pdf" 1;
}

map "$o9s_nginx_document$o9s_nginx_pdf" $o9s_nginx_csp {
    default "";
    1 "{{ ENV.O9S_NGINX_CSP_UPGRADE_INSECURE_REQUESTS }} {{ ENV.O9S_NGINX_CSP_BLOCK_ALL_MIXED_CONTENT }} {{ ENV.O9S_NGINX_CSP_SANDBOX }} {{ ENV.O9S_NGINX_CSP_REQUIRE_TRUSTED_TYPES_FOR }} base-uri {{ ENV.O9S_NGINX_CSP_BASE_URI }}; child-src {{ ENV.O9S_NGINX_CSP_CHILD_SRC }}; connect-src {{ ENV.O9S_NGINX_CSP_CONNECT_SRC }}; default-src {{ ENV.O9S_NGINX_CSP_DEFAULT_SRC }}; font-src {{ ENV.O9S_NGINX_CSP_FONT_SRC }}; form-action {{ ENV.O9S_NGINX_CSP_FORM_ACTION }}; frame-ancestors {{ ENV.O9S_NGINX_CSP_FRAME_ANCESTORS }}; frame-src {{ ENV.O9S_NGINX_CSP_FRAME_SRC }}; img-src {{ ENV.O9S_NGINX_CSP_IMG_SRC }}; manifest-src {{ ENV.O9S_NGINX_CSP_MANIFEST_SRC }}; media-src {{ ENV.O9S_NGINX_CSP_MEDIA_SRC }}; object-src {{ ENV.O9S_NGINX_CSP_OBJECT_SRC }}; script-src {{ ENV.O9S_NGINX_CSP_SCRIPT_SRC }}; style-src {{ ENV.O9S_NGINX_CSP_STYLE_SRC }}; worker-src {{ ENV.O9S_NGINX_CSP_WORKER_SRC }};{% if ENV.O9S_NGINX_CSP_REPORT_TO %} report-to {{ ENV.O9S_NGINX_CSP_REPORT_TO }};{% endif %}{% if ENV.O9S_NGINX_CSP_REPORT_URI %} report-uri {{ ENV.O9S_NGINX_CSP_REPORT_URI }};{% endif %}";
}

map $o9s_nginx_document $o9s_nginx_coep {
    default "";
    1 "{{ ENV.O9S_NGINX_COEP_POLICY }}{% if ENV.O9S_NGINX_COEP_REPORT_TO %}; report-to={{ ENV.O9S_NGINX_COEP_REPORT_TO }}{% endif %}";
}
