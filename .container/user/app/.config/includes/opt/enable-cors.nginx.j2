# Handle preflight OPTIONS requests
if ($request_method = 'OPTIONS') {
    add_header 'Access-Control-Allow-Origin'    "{{ ENV.O9S_NGINX_CORS_ALLOW_ORIGIN }}";
    add_header 'Access-Control-Allow-Methods'   "{{ ENV.O9S_NGINX_CORS_ALLOW_METHODS }}";
    add_header 'Access-Control-Allow-Headers'   "{{ ENV.O9S_NGINX_CORS_ALLOW_HEADERS }}";
    add_header 'Access-Control-Max-Age'         "{{ ENV.O9S_NGINX_CORS_MAX_AGE }}";
    add_header 'Content-Type'                   'text/plain; charset=utf-8';
    add_header 'Content-Length'                 0;
    return 204;
}

# Handle CORS headers for GET and POST requests
if ($request_method ~* "^(GET|POST)$") {
    add_header 'Access-Control-Allow-Origin'    "{{ ENV.O9S_NGINX_CORS_ALLOW_ORIGIN }}";
    add_header 'Access-Control-Allow-Methods'   "{{ ENV.O9S_NGINX_CORS_ALLOW_METHODS }}";
    add_header 'Access-Control-Allow-Headers'   "{{ ENV.O9S_NGINX_CORS_ALLOW_HEADERS }}";
    add_header 'Access-Control-Expose-Headers'  "{{ ENV.O9S_NGINX_CORS_EXPOSE_HEADERS }}";
}