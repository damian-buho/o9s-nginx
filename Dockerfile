ARG B19_GCC_BASE_IMAGE=registry.invalid/b19/gcc-16:latest
ARG B19_HOME="/app"
ARG B19_RUST_GNU_BASE_IMAGE=registry.invalid/b19/rust-gnu:latest
ARG B19_UBUNTU_BASE_IMAGE=registry.invalid/b19/ubuntu/resolute:latest
ARG B19_UBUNTU_SERIES=resolute
ARG O9S_NGINX_CACHE_PATH=${B19_HOME}/cache
ARG O9S_NGINX_LOG_PATH=${B19_HOME}/log
ARG O9S_NGINX_MODULES_PATH=/usr/local/lib/nginx
ARG O9S_NGINX_ROOT="${B19_HOME}"
ARG O9S_NGINX_TEMP_PATH=${B19_HOME}/tmp
ARG O9S_NGINX_TLS_PATH=${B19_HOME}/tls
ARG O9S_NGINX_UPSTREAM_VERSION=1.30.0

FROM ${B19_GCC_BASE_IMAGE} AS o9s-nginx-builder

ARG B19_COMPILE_CACHE
ARG B19_COLOR
ARG B19_FETCH_DOCKER_CACHE
ARG B19_FETCH_LOCAL_CACHE
ARG B19_OFFGRID_MODE
ARG B19_VERBOSITY
ARG CCACHE_REMOTE_STORAGE
ARG LANG=""
ARG M6E_AI=N
ARG M6E_APT_CACHE_HOST=""
ARG M6E_APT_CACHE_PORT=""
ARG M6E_NAMESPACE
ARG M6E_NEAR_CACHE_HOST=""
ARG M6E_PROJECT
ARG O9S_NGINX_CACHE_PATH
ARG O9S_NGINX_LOG_PATH
ARG O9S_NGINX_MODULES_PATH
ARG O9S_NGINX_TEMP_PATH
ARG O9S_NGINX_TLS_PATH
ARG O9S_NGINX_UPSTREAM_VERSION
ARG SCCACHE_REDIS_ENDPOINT
ARG TARGETARCH

ENV O9S_NGINX_CACHE_PATH=${O9S_NGINX_CACHE_PATH}            \
    O9S_NGINX_LOG_PATH="${O9S_NGINX_LOG_PATH}"              \
    O9S_NGINX_MODULES_PATH="${O9S_NGINX_MODULES_PATH}"      \
    O9S_NGINX_TLS_PATH="${O9S_NGINX_TLS_PATH}"


USER 0

WORKDIR "${B19_TEMP_PATH}"

COPY --chown=${B19_UID}:${B19_GID}                               .container/compile-gcc/                /

RUN --mount=type=bind,from=fetch,source=.,target=/fetch                                           \
    --mount=type=cache,target=${B19_DOWNLOAD_PATH},sharing=shared                                 \
    --mount=type=cache,target=${B19_COMPILE_CACHE_PATH},sharing=shared                            \
    --mount=type=cache,id=apt-cache-${B19_UBUNTU_SERIES}-${TARGETARCH},target=/var/cache/apt,sharing=shared     \
    --mount=type=cache,id=apt-lists-${B19_UBUNTU_SERIES}-${TARGETARCH},target=/var/lib/apt,sharing=shared       \
    --mount=type=tmpfs,target=${B19_TEMP_PATH}                                                    \
    build-stage compile-gcc

# hadolint ignore=DL3066 # B19_UID comes from the root
USER ${B19_UID}

FROM ${B19_RUST_GNU_BASE_IMAGE} AS o9s-nginx-acme-builder

ARG B19_COMPILE_CACHE
ARG B19_HOME
ARG B19_COLOR
ARG B19_FETCH_DOCKER_CACHE
ARG B19_FETCH_LOCAL_CACHE
ARG B19_OFFGRID_MODE
ARG B19_VERBOSITY
ARG CCACHE_REMOTE_STORAGE
ARG LANG=""
ARG M6E_AI=N
ARG M6E_APT_CACHE_HOST=""
ARG M6E_APT_CACHE_PORT=""
ARG M6E_NAMESPACE
ARG M6E_NEAR_CACHE_HOST=""
ARG M6E_PROJECT
ARG O9S_NGINX_MODULES_PATH
ARG SCCACHE_REDIS_ENDPOINT
ARG TARGETARCH

WORKDIR "${B19_TEMP_PATH}"

COPY --from=o9s-nginx-builder /export/                          ${B19_HOME}/nginx-src/
COPY --chown=${B19_UID}:${B19_GID}                              .container/compile-rust/                /

USER 0

# What we are trying to do: build the ACME rust module WITHOUT sccache. b19/rust
# bakes B19_COMPILE_CACHE=sccache into its ENV, but the pinned sccache 0.14.0
# daemon fails to start (hangs on --start-server even in a clean container), so
# any RUSTC_WRAPPER=sccache invocation times out and fails the build. The ACME
# module is a single small crate (negligible cache benefit), so compiling it
# directly is reliable. Revisit (drop this override) once b19/rust's sccache is
# fixed upstream. The inherited ARG below is shadowed by this ENV for RUN shells.
ENV B19_COMPILE_CACHE=off

RUN --mount=type=cache,id=apt-cache-${B19_UBUNTU_SERIES}-${TARGETARCH},target=/var/cache/apt,sharing=shared     \
    --mount=type=cache,id=apt-lists-${B19_UBUNTU_SERIES}-${TARGETARCH},target=/var/lib/apt,sharing=shared       \
    --mount=type=tmpfs,target=${B19_TEMP_PATH}                                                    \
    build-stage compile-rust

# hadolint ignore=DL3066 # B19_UID comes from the root
USER ${B19_UID}

FROM ${B19_UBUNTU_BASE_IMAGE} AS o9s-nginx

