location / {
    root {{ ENV.O9S_NGINX_PUBLIC_PATH }};
    try_files $uri $uri/ @backend;
}

location @backend {
    set $backend "{{ ENV.O9S_NGINX_BACKEND_SCHEME }}://{{ ENV.O9S_NGINX_BACKEND_HOST }}:{{ ENV.O9S_NGINX_BACKEND_PORT }}";
    proxy_pass $backend;
}
