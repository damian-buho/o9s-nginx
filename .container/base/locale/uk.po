msgid "The server could not understand the request."
msgstr "Сервер не зміг зрозуміти запит."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:45
msgid "Authentication is required to access this resource."
msgstr "Для доступу до цього ресурсу потрібна автентифікація."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:46
msgid "Payment is required to access this resource."
msgstr "Для доступу до цього ресурсу потрібна оплата."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:47
msgid "You do not have permission to access this resource."
msgstr "У вас немає прав доступу до цього ресурсу."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:48
msgid "The requested resource could not be found."
msgstr "Запитуваний ресурс не знайдено."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:49
msgid ""
"Too many requests were sent in a short time. Please wait a moment and try "
"again."
msgstr ""
"Надіслано забагато запитів за короткий час. Зачекайте трохи й спробуйте ще "
"раз."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:50
msgid "Something went wrong on the server side. Please try again later."
msgstr "На сервері щось пішло не так. Спробуйте ще раз пізніше."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:51
msgid "The server received an invalid response from an upstream service."
msgstr "Сервер отримав недійсну відповідь від вихідної служби."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:52
msgid "The service is temporarily unavailable. Please try again later."
msgstr "Служба тимчасово недоступна. Спробуйте ще раз пізніше."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:53
msgid "The server did not receive a timely response from an upstream service."
msgstr "Сервер не отримав своєчасної відповіді від вихідної служби."

#: .container/user/build.d/user/post/260-generate-error-pages.sh:66
